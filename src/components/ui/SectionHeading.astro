---
type HeadingLevel = 'h1' | 'h2' | 'h3';

interface Props {
  title: string;
  label?: string;
  description?: string;
  number?: string;
  align?: 'start' | 'center';
  as?: HeadingLevel;
  id?: string;
  class?: string;
}

const {
  title,
  label,
  description,
  number,
  align = 'start',
  as: Tag = 'h2',
  id,
  class: className,
} = Astro.props;

const hasEyebrow = Boolean(label || number);
---

<div
  class:list={[
    'flex flex-col gap-3',
    align === 'center' && 'items-center text-center',
    className,
  ]}
>
  {
    hasEyebrow && (
      <p
        class:list={[
          'flex items-center gap-3 font-mono text-label uppercase tracking-widest text-muted-foreground',
          align === 'center' && 'justify-center',
        ]}
      >
        {number && <span class="text-primary">{number}</span>}
        {label && <span>{label}</span>}
      </p>
    )
  }

  <Tag id={id} class="text-balance text-display font-semibold text-foreground">
    {title}
  </Tag>

  {
    description && (
      <p
        class:list={[
          'max-w-measure text-lead text-muted-foreground',
          align === 'center' && 'mx-auto',
        ]}
      >
        {description}
      </p>
    )
  }
</div>
