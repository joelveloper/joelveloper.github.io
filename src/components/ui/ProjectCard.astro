---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import ProjectIllustration from '@/components/ui/ProjectIllustration.astro';
import StatusBadge from '@/components/ui/StatusBadge.astro';
import Surface from '@/components/ui/Surface.astro';
import TechBadge from '@/components/ui/TechBadge.astro';
import type { ProjectStatus } from '@/components/ui/StatusBadge.astro';

type ProjectCategory = 'saas' | 'client';

interface ProjectCardImage {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  description: string;
  category: ProjectCategory;
  status: ProjectStatus;
  technologies: string[];
  href?: string;
  image?: ProjectCardImage;
  maxTechnologies?: number;
  class?: string;
}

const {
  title,
  description,
  category,
  status,
  technologies,
  href,
  image,
  maxTechnologies = 4,
  class: className,
} = Astro.props;

const categoryLabels: Record<ProjectCategory, string> = {
  saas: 'SaaS',
  client: 'Desarrollo exclusivo',
};

const visibleTechnologies = technologies.slice(0, maxTechnologies);
const remainingTechnologies = Math.max(technologies.length - visibleTechnologies.length, 0);
---

<Surface
  as="article"
  variant="default"
  padding="md"
  class:list={['project-card portfolio-card-hover flex h-full flex-col gap-5', className]}
>
  <span aria-hidden="true" class="project-card__border"></span>
  {
    image && (
      <ProjectIllustration
        image={image}
        loading="lazy"
        class="aspect-[16/9] w-full rounded-lg border border-border object-cover"
      />
    )
  }

  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="font-mono text-label uppercase tracking-widest text-muted-foreground">
      {categoryLabels[category]}
    </p>
    <StatusBadge status={status} />
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-title font-semibold text-foreground">
      {
        href ? (
          <a href={href} class="rounded-sm transition-colors hover:text-primary">
            {title}
          </a>
        ) : (
          <span>{title}</span>
        )
      }
    </h3>
    <p class="max-w-measure text-sm text-muted-foreground">{description}</p>
  </div>

  {
    technologies.length > 0 && (
      <ul class="flex flex-wrap gap-2" aria-label={`Tecnologías de ${title}`}>
        {visibleTechnologies.map((technology) => (
          <li>
            <TechBadge label={technology} />
          </li>
        ))}
        {remainingTechnologies > 0 && (
          <li>
            <TechBadge label={`+${remainingTechnologies}`} />
          </li>
        )}
      </ul>
    )
  }

  <div class="mt-auto pt-1">
    {
      href ? (
        <ButtonLink href={href} variant="secondary" ariaLabel={`Ver proyecto: ${title}`}>
          Ver proyecto
        </ButtonLink>
      ) : (
        <p class="inline-flex items-center gap-2 text-caption text-muted-foreground">
          <span aria-hidden="true" class="size-1.5 rounded-full border border-muted-foreground" />
          Caso de estudio en preparación
        </p>
      )
    }
  </div>
</Surface>
