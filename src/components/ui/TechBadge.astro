---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-md border border-border bg-surface px-2.5 py-1 font-mono text-xs text-muted-foreground',
    className,
  ]}
>
  {label}
</span>
