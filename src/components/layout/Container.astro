---
type ContainerSize = 'default' | 'wide' | 'narrow';

interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'main' | 'article';
  size?: ContainerSize;
  id?: string;
  class?: string;
}

const { as: Tag = 'div', size = 'default', id, class: className } = Astro.props;

const sizes: Record<ContainerSize, string> = {
  default: 'max-w-[1160px]',
  wide: 'max-w-[1280px]',
  narrow: 'max-w-measure',
};
---

<Tag id={id} class:list={['mx-auto w-full px-5 sm:px-6 lg:px-8', sizes[size], className]}>
  <slot />
</Tag>
