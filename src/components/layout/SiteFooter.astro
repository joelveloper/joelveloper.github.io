---
import Container from '@/components/layout/Container.astro';

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  siteName?: string;
  github?: string;
  email?: string;
  links?: FooterLink[];
  year?: number;
}

const {
  siteName = 'Joel Cantero',
  github = 'https://github.com/joelveloper',
  email = 'alfonzojoel@hotmail.com',
  links = [
    { label: 'YouTube', href: 'https://www.youtube.com/@joeldeveloper', external: true },
    { label: 'Instagram', href: 'https://www.instagram.com/joel.developer', external: true },
  ],
  year = new Date().getFullYear(),
} = Astro.props;

const linkClass =
  'rounded-sm text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline';
---

<footer id="contacto" class="mt-20 border-t border-border bg-surface">
  <Container class="flex flex-col gap-8 py-12 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex max-w-measure flex-col gap-3">
      <p class="font-mono text-label uppercase tracking-widest text-primary">Contacto</p>
      <p class="text-title font-semibold text-foreground">{siteName}</p>
      <p class="text-sm text-muted-foreground">
        Software para procesos complejos: plataformas SaaS y aplicaciones empresariales con .NET,
        PostgreSQL y tecnologías web.
      </p>
    </div>

    <nav aria-label="Enlaces profesionales" class="flex flex-col gap-3">
      <ul class="flex flex-col gap-2 text-sm">
        <li>
          <a href={`mailto:${email}`} class={linkClass}>Correo</a>
        </li>
        <li>
          <a href={github} class={linkClass} target="_blank" rel="noopener noreferrer">GitHub</a>
        </li>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class={linkClass}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>

  <Container class="border-t border-border py-6">
    <p class="text-caption text-muted-foreground">
      &copy; {year} {siteName}. Todos los derechos reservados.
    </p>
  </Container>
</footer>
