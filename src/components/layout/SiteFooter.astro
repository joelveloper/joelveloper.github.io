---
import Container from '@/components/layout/Container.astro';
import { contactLinks } from '@/data/navigation';
import { profile } from '@/data/profile';

interface Props {
  siteName?: string;
  year?: number;
}

const { siteName = profile.name, year = new Date().getFullYear() } = Astro.props;

const linkClass =
  'inline-block rounded-sm py-1 text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline';
---

<footer class="mt-20 border-t border-border bg-surface">
  <Container class="flex flex-col gap-8 py-12 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex max-w-measure flex-col gap-3">
      <p class="font-mono text-label uppercase tracking-widest text-primary">Joel Cantero</p>
      <p class="text-title font-semibold text-foreground">{siteName} · {profile.role}</p>
      <p class="text-sm text-muted-foreground">
        Software para problemas reales. Aplicaciones empresariales, plataformas SaaS y
        automatización documental.
      </p>
    </div>

    <nav aria-label="Enlaces profesionales" class="flex flex-col gap-3">
      <ul class="flex flex-col gap-2 text-sm">
        {
          contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={linkClass}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>

  <Container class="border-t border-border py-6">
    <p class="text-caption text-muted-foreground">
      &copy; {year} {siteName}. Todos los derechos reservados.
    </p>
  </Container>
</footer>
