---
import Container from '@/components/layout/Container.astro';
import MobileNavigation from '@/components/layout/MobileNavigation.astro';
import ThemeSwitcher from '@/components/layout/ThemeSwitcher.astro';
import { profile } from '@/data/profile';

export interface NavItem {
  label: string;
  href: string;
}

interface Props {
  siteName?: string;
  monogram?: string;
  brandHref?: string;
  nav?: NavItem[];
}

const {
  siteName = profile.name,
  monogram = profile.monogram,
  brandHref = '/',
  nav = [],
} = Astro.props;

const linkClass =
  'inline-block rounded-sm py-1 text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline';
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-border bg-background">
  <Container class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 py-4 lg:gap-x-6">
    <a href={brandHref} class="group inline-flex items-center gap-3 rounded-sm">
      <span
        aria-hidden="true"
        class="inline-flex size-9 items-center justify-center rounded-md border border-border bg-surface font-mono text-label font-medium tracking-normal text-primary"
        >{monogram}</span
      >
      <span class="text-base font-semibold tracking-tight text-foreground">{siteName}</span>
    </a>

    {
      nav.length > 0 && (
        <nav aria-label="Navegación principal" class="hidden md:block">
          <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm lg:gap-x-5">
            {nav.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="flex items-center gap-2">
      <ThemeSwitcher />
      <MobileNavigation nav={nav} siteName={siteName} monogram={monogram} brandHref={brandHref} />
    </div>
  </Container>
</header>
