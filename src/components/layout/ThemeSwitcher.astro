---
// Toggle binario Claro / Oscuro (ADR-002, docs/02-DISENO-VISUAL.md §6).
// Botón circular de 32px con un área táctil ampliada a 40px mediante `::before`
// (5px por lado: el pseudo-elemento se posiciona respecto a la caja de relleno,
// que mide 30px por el borde de 1px).
// Sin preferencia guardada, el tema sigue a `prefers-color-scheme`; al pulsar,
// la elección se guarda en localStorage. El icono visible se resuelve con CSS
// (`global.css`) a partir del tema efectivo, sin esperar a este script.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Cambiar tema de color"
  class="relative inline-flex size-8 items-center justify-center rounded-full border border-border bg-transparent text-muted-foreground transition-colors before:absolute before:-inset-[5px] before:rounded-full hover:border-input hover:text-foreground focus-visible:text-foreground active:text-primary"
>
  <svg
    data-theme-icon="moon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-4"
  >
    <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z" />
  </svg>
  <svg
    data-theme-icon="sun"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-4"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
</button>

<noscript>
  <style is:inline>
    [data-theme-toggle] {
      display: none !important;
    }
  </style>
</noscript>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (toggle) {
    const root = document.documentElement;
    const storageKey = 'appearance';
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

    const effectiveTheme = (): 'light' | 'dark' => {
      const appearance = root.dataset.appearance;
      if (appearance === 'light' || appearance === 'dark') return appearance;
      return systemDark.matches ? 'dark' : 'light';
    };

    const updateLabel = () => {
      toggle.setAttribute(
        'aria-label',
        effectiveTheme() === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro',
      );
    };

    const applyTheme = (theme: 'light' | 'dark') => {
      root.dataset.appearance = theme;
      root.classList.remove('light', 'dark');
      root.classList.add(theme);

      try {
        window.localStorage.setItem(storageKey, theme);
      } catch {
        // El tema se aplica igualmente durante la sesión actual.
      }

      updateLabel();
    };

    updateLabel();

    toggle.addEventListener('click', () => {
      applyTheme(effectiveTheme() === 'dark' ? 'light' : 'dark');
    });

    // Mientras no exista una elección guardada, el tema sigue al sistema.
    systemDark.addEventListener('change', updateLabel);
  }
</script>
