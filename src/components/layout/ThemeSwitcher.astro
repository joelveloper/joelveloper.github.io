---
const options = [
  { value: 'system', label: 'Sistema' },
  { value: 'light', label: 'Claro' },
  { value: 'dark', label: 'Oscuro' },
] as const;
---

<div class="relative" data-theme-switcher>
  <button
    type="button"
    data-theme-trigger
    aria-label="Cambiar apariencia"
    aria-controls="theme-options"
    aria-expanded="false"
    class="inline-flex size-11 items-center justify-center rounded-lg border border-border text-foreground transition-colors hover:border-primary/60 hover:bg-surface-raised"
  >
    <svg
      data-theme-icon="system"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5"
    >
      <rect x="3" y="4" width="18" height="12" rx="2" />
      <path d="M8 20h8M12 16v4" />
    </svg>
    <svg
      data-theme-icon="light"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5"
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
    <svg
      data-theme-icon="dark"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5"
    >
      <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z" />
    </svg>
  </button>

  <div
    id="theme-options"
    data-theme-panel
    hidden
    class="absolute right-0 top-full z-50 mt-2 rounded-xl border border-border bg-surface p-1 shadow-lg"
  >
    <fieldset class="flex flex-row gap-1">
      <legend class="sr-only">Apariencia del sitio</legend>
      {
        options.map((option) => (
          <label class="relative block cursor-pointer">
            <input
              type="radio"
              name="appearance"
              value={option.value}
              data-theme-option
              class="peer sr-only"
            />
            <span class="flex size-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-surface-raised peer-checked:bg-primary/10 peer-checked:text-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring">
              {option.value === 'system' && (
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-5"
                >
                  <rect x="3" y="4" width="18" height="12" rx="2" />
                  <path d="M8 20h8M12 16v4" />
                </svg>
              )}
              {option.value === 'light' && (
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-5"
                >
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
              )}
              {option.value === 'dark' && (
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-5"
                >
                  <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z" />
                </svg>
              )}
            </span>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="pointer-events-none absolute right-1 top-1 size-3 text-primary opacity-0 peer-checked:opacity-100"
            >
              <path d="m5 12 4 4L19 6" />
            </svg>
            <span class="sr-only">{option.label}</span>
          </label>
        ))
      }
    </fieldset>
  </div>
</div>

<noscript>
  <style is:inline>
    [data-theme-switcher] {
      display: none !important;
    }
  </style>
</noscript>

<script>
  const switcher = document.querySelector<HTMLElement>('[data-theme-switcher]');

  if (switcher) {
    const root = document.documentElement;
    const trigger = switcher.querySelector<HTMLButtonElement>('[data-theme-trigger]');
    const panel = switcher.querySelector<HTMLElement>('[data-theme-panel]');
    const options = [...switcher.querySelectorAll<HTMLInputElement>('[data-theme-option]')];
    const storageKey = 'appearance';
    const preferences = new Set(['system', 'light', 'dark']);

    if (trigger && panel && options.length > 0) {
      const applyPreference = (preference: string, persist: boolean) => {
        const value = preferences.has(preference) ? preference : 'system';

        root.dataset.appearance = value;
        root.classList.remove('light', 'dark');
        if (value !== 'system') root.classList.add(value);

        for (const option of options) {
          option.checked = option.value === value;
        }

        if (persist) {
          try {
            window.localStorage.setItem(storageKey, value);
          } catch {
            // La preferencia se aplica igualmente durante la sesión actual.
          }
        }
      };

      const openPanel = () => {
        panel.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        const selected = options.find((option) => option.checked) ?? options[0];
        selected.focus();
      };

      const closePanel = (restoreFocus = true) => {
        if (panel.hidden) return;

        panel.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');

        if (restoreFocus && trigger.getClientRects().length > 0) {
          trigger.focus();
        }
      };

      applyPreference(root.dataset.appearance ?? 'system', false);

      trigger.addEventListener('click', () => {
        if (panel.hidden) {
          openPanel();
        } else {
          closePanel();
        }
      });

      for (const option of options) {
        option.addEventListener('change', () => {
          if (!option.checked) return;
          applyPreference(option.value, true);
          closePanel();
        });
      }

      document.addEventListener('click', (event) => {
        if (
          !panel.hidden &&
          event.target instanceof Node &&
          !switcher.contains(event.target)
        ) {
          closePanel(false);
        }
      });

      document.addEventListener('focusin', (event) => {
        if (
          !panel.hidden &&
          event.target instanceof Node &&
          !switcher.contains(event.target)
        ) {
          closePanel(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.hidden) {
          event.preventDefault();
          event.stopPropagation();
          closePanel();
        }
      });
    }
  }
</script>
