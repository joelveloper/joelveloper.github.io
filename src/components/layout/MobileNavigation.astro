---
import Container from '@/components/layout/Container.astro';
import type { NavItem } from '@/components/layout/SiteHeader.astro';

interface Props {
  nav: NavItem[];
  siteName: string;
  monogram: string;
  brandHref: string;
}

const { nav, siteName, monogram, brandHref } = Astro.props;

const dialogLinkClass =
  'flex min-h-12 items-center py-3 text-base font-medium text-foreground underline-offset-4 hover:underline';
---

{
  nav.length > 0 && (
    <>
      <button
        type="button"
        data-menu-trigger
        aria-label="Abrir menú de navegación"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        aria-haspopup="dialog"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-border px-3 text-sm font-medium text-foreground transition-colors hover:border-primary/60 hover:bg-surface-raised md:hidden"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="size-5"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span class="hidden sm:inline">Menú</span>
      </button>

      <dialog
        id="mobile-navigation"
        data-mobile-nav-dialog
        aria-labelledby="mobile-nav-title"
        class="fixed inset-x-0 bottom-auto top-0 m-0 h-auto max-h-dvh w-full max-w-none overflow-y-auto border-b border-border bg-background p-0 text-foreground backdrop:bg-black/60 md:hidden"
      >
        <h2 id="mobile-nav-title" class="sr-only">
          Navegación del sitio
        </h2>

        <Container class="pb-6 pt-3">
          <div class="flex items-center justify-between gap-4 border-b border-border pb-3">
            <button
              type="button"
              data-menu-close
              aria-label="Cerrar menú de navegación"
              class="inline-flex size-11 items-center justify-center rounded-lg border border-border text-foreground transition-colors hover:border-primary/60 hover:bg-surface-raised"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                class="size-5"
              >
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>

            <a
              href={brandHref}
              class="order-first inline-flex items-center gap-3 rounded-sm md:order-none"
            >
              <span
                aria-hidden="true"
                class="inline-flex size-9 items-center justify-center rounded-md border border-border bg-surface font-mono text-label font-medium tracking-normal text-primary"
                >{monogram}</span
              >
              <span class="text-base font-semibold tracking-tight text-foreground">{siteName}</span>
            </a>
          </div>

          <nav aria-label="Navegación principal" class="mt-2">
            <ul class="flex flex-col divide-y divide-border">
              {nav.map((item) => (
                <li>
                  <a href={item.href} class={dialogLinkClass}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </Container>
      </dialog>

      <noscript>
        <nav aria-label="Navegación principal" class="w-full pt-2 md:hidden">
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-block rounded-sm py-1 text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <style is:inline>[data-menu-trigger] { display: none !important; }</style>
      </noscript>
    </>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-nav-dialog]');
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');

  if (dialog && trigger) {
    const desktopMedia = window.matchMedia('(min-width: 768px)');
    let focusAfterClose: 'trigger' | 'target' | 'none' = 'trigger';
    let focusTarget: HTMLElement | null = null;

    const setExpanded = (expanded: boolean) => {
      trigger.setAttribute('aria-expanded', String(expanded));
    };

    const openMenu = () => {
      if (dialog.open || trigger.getClientRects().length === 0) return;
      dialog.showModal();
      setExpanded(true);
    };

    const closeMenu = (focus: 'trigger' | 'target' | 'none' = 'trigger', target?: HTMLElement) => {
      if (!dialog.open) return;
      focusAfterClose = focus;
      focusTarget = target ?? null;
      dialog.close();
      setExpanded(false);
    };

    trigger.addEventListener('click', () => {
      if (dialog.open) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    dialog.querySelectorAll<HTMLElement>('[data-menu-close]').forEach((button) => {
      button.addEventListener('click', () => closeMenu());
    });

    dialog.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href') ?? '';
        const target = href.startsWith('#') ? document.getElementById(href.slice(1)) : null;

        if (target) {
          closeMenu('target', target);
        } else {
          closeMenu('none');
        }
      });
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeMenu();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;

      const focusable = [...dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter(
        (element) => element.getClientRects().length > 0,
      );

      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || !dialog.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    });

    dialog.addEventListener('close', () => {
      setExpanded(false);

      if (dialog.open) return;

      if (focusAfterClose === 'target' && focusTarget?.isConnected) {
        if (!focusTarget.hasAttribute('tabindex')) focusTarget.setAttribute('tabindex', '-1');
        focusTarget.focus({ preventScroll: true });
      } else if (focusAfterClose === 'trigger' && trigger.getClientRects().length > 0) {
        trigger.focus();
      }

      focusAfterClose = 'trigger';
      focusTarget = null;
    });

    desktopMedia.addEventListener('change', (event) => {
      if (event.matches && dialog.open) closeMenu('none');
    });
  }
</script>
