---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Surface from '@/components/ui/Surface.astro';
import TechBadge from '@/components/ui/TechBadge.astro';
import { mainNavigation } from '@/data/navigation';
import { emailHref, profile, socialLinks } from '@/data/profile';
import { getApprovedProjectCards } from '@/lib/projects';

const projectCards = await getApprovedProjectCards();

const specialties = [
  {
    title: 'Aplicaciones empresariales',
    description:
      'Software para procesos de gestión, operación y control, con reglas de negocio claras y trazabilidad.',
    technologies: '.NET · ASP.NET Core · Blazor',
  },
  {
    title: 'Plataformas SaaS',
    description:
      'Productos con administración, identidad y operación por empresa, pensados para crecer sin perder orden.',
    technologies: 'Multitenencia · Identity · APIs',
  },
  {
    title: 'Arquitectura de software',
    description:
      'Diseño de soluciones modulares y límites explícitos, priorizando mantenibilidad, seguridad y evolución.',
    technologies: 'CQRS · Vertical Slices · Monolito modular',
  },
  {
    title: 'Automatización documental',
    description:
      'Importación de documentos, extracción de datos, reglas contractuales y conciliación de información.',
    technologies: 'PDF · Reglas · Conciliación',
  },
];

const processSteps = [
  {
    title: 'Comprender el problema',
    description:
      'Escucho el contexto, las restricciones y el resultado esperado antes de elegir una solución.',
  },
  {
    title: 'Modelar la solución',
    description:
      'Defino alcance, datos, reglas y límites; elijo una arquitectura que pueda evolucionar.',
  },
  {
    title: 'Implementar',
    description:
      'Construyo de extremo a extremo, cuidando seguridad, mantenibilidad y experiencia de uso.',
  },
  {
    title: 'Validar y mejorar',
    description:
      'Pruebo con casos reales, reviso las decisiones y ajusto según lo aprendido.',
  },
];

const technologyGroups = [
  {
    title: 'Aplicación y datos',
    items: ['C#', '.NET', 'ASP.NET Core', 'EF Core', 'SQL Server', 'PostgreSQL'],
  },
  {
    title: 'Arquitectura',
    items: ['Minimal APIs', 'Web API', 'CQRS', 'Vertical Slices', 'Monolito modular'],
  },
  {
    title: 'Frontend',
    items: ['Blazor', 'MudBlazor', 'React', 'Vite', 'TypeScript'],
  },
  {
    title: 'Infraestructura',
    items: ['Linux / Ubuntu', 'Nginx', 'Docker'],
  },
];

const contactChannels = socialLinks;
---

<BaseLayout
  title="Joel Cantero — Full Stack .NET Developer"
  description="Portafolio de Joel Cantero, Full Stack .NET Developer en Asunción, Paraguay. Aplicaciones empresariales, plataformas SaaS, arquitectura de software y automatización documental."
  nav={mainNavigation}
>
  <section
    id="inicio"
    class="overflow-hidden border-b border-border"
    aria-labelledby="inicio-titulo"
  >
    <Container class="grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-16 lg:py-28">
      <div class="flex flex-col gap-6">
        <p class="font-mono text-label uppercase tracking-widest text-primary">
          Full Stack .NET Developer · Paraguay
        </p>
        <h1
          id="inicio-titulo"
          class="max-w-[16ch] text-balance text-hero font-semibold text-foreground"
        >
          {profile.headline}
        </h1>
        <p class="max-w-measure text-lead text-muted-foreground">
          {profile.description}
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <ButtonLink href="#proyectos" variant="primary" size="lg">Explorar proyectos</ButtonLink>
          <ButtonLink href="#contacto" variant="secondary" size="lg">Contactar</ButtonLink>
          <ButtonLink href={profile.github} variant="ghost" size="lg" external>
            GitHub <span aria-hidden="true">↗</span>
          </ButtonLink>
        </div>
        <p class="font-mono text-caption text-muted-foreground">
          {profile.location} · Trabajo de extremo a extremo
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none" aria-hidden="true">
        <div class="absolute -inset-8 rounded-full bg-primary/5 blur-3xl"></div>
        <div class="relative overflow-hidden rounded-2xl border border-border bg-surface">
          <div class="flex items-center justify-between border-b border-border px-5 py-3">
            <span class="font-mono text-label uppercase tracking-widest text-muted-foreground">
              sistema / portafolio
            </span>
            <span class="font-mono text-label font-medium tracking-normal text-primary">JC</span>
          </div>

          <div class="flex flex-col gap-3 p-5">
            <div class="rounded-lg border border-primary/40 bg-primary/10 p-4">
              <p class="font-mono text-label uppercase tracking-widest text-primary">Interfaz</p>
              <p class="mt-1 text-sm text-foreground">Blazor · React · Astro</p>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-lg border border-border bg-surface-raised p-4">
                <p class="font-mono text-label uppercase tracking-widest text-muted-foreground">
                  Aplicación
                </p>
                <p class="mt-1 text-sm text-foreground">.NET · ASP.NET Core</p>
              </div>
              <div class="rounded-lg border border-border bg-surface-raised p-4">
                <p class="font-mono text-label uppercase tracking-widest text-muted-foreground">
                  Arquitectura
                </p>
                <p class="mt-1 text-sm text-foreground">CQRS · Vertical Slices</p>
              </div>
            </div>

            <div class="rounded-lg border border-border bg-background/70 p-4">
              <p class="font-mono text-label uppercase tracking-widest text-muted-foreground">
                Datos e infraestructura
              </p>
              <p class="mt-1 text-sm text-foreground">
                SQL Server · PostgreSQL · Linux · Nginx · Docker
              </p>
            </div>

            <div class="flex items-center gap-2 pt-1">
              <span class="size-1.5 rounded-full bg-positive"></span>
              <span class="font-mono text-caption text-muted-foreground">
                Del problema al despliegue
              </span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Container as="section" id="sobre-mi" class="py-16 sm:py-20 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
      <div class="flex flex-col gap-8">
        <SectionHeading
          number="01"
          label="Sobre mí"
          title="Del problema al software que evoluciona"
        />

        <div class="flex max-w-measure flex-col gap-5 text-muted-foreground">
          <p>
            Empecé desarrollando proyectos personales de aprendizaje. En 2020 desarrollé una
            aplicación de escritorio que comercialicé para la gestión de archivos de auditoría; ese
            trabajo fue el origen de SGAA.
          </p>
          <p>
            Desde entonces he trabajado en su evolución hacia una plataforma web de gestión de
            auditoría y aseguramiento, comercializada desde agosto de 2025. Me encargué del
            proceso de extremo a extremo: investigación, arquitectura, modelado, backend,
            frontend, infraestructura y despliegue. Colaboré con profesionales de auditoría para
            comprender las necesidades funcionales.
          </p>
          <p>
            Me motiva crear software con identidad propia que resuelva problemas reales, cuidando
            la arquitectura, la calidad, la seguridad y la evolución del producto. Actualmente
            amplío esa base con formación continua en ingeniería de software.
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <Surface variant="default" class="flex flex-col gap-5">
          <h3 class="font-mono text-label uppercase tracking-widest text-muted-foreground">
            Trayectoria
          </h3>
          <ol class="flex flex-col gap-5">
            <li class="grid gap-1 border-l border-border pl-4">
              <span class="font-mono text-label text-primary">2020</span>
              <span class="text-sm text-foreground">
                Primera aplicación de escritorio comercializada para gestión de archivos de
                auditoría.
              </span>
            </li>
            <li class="grid gap-1 border-l border-border pl-4">
              <span class="font-mono text-label text-primary">Agosto 2025</span>
              <span class="text-sm text-foreground">
                Comencé la comercialización de la plataforma web SGAA.
              </span>
            </li>
            <li class="grid gap-1 border-l border-border pl-4">
              <span class="font-mono text-label text-primary">Actualidad</span>
              <span class="text-sm text-foreground">
                Mantengo SGAA en producción y desarrollo AuditaPy.
              </span>
            </li>
          </ol>
        </Surface>

        <Surface variant="raised" class="flex flex-col gap-2">
          <p class="font-mono text-label uppercase tracking-widest text-muted-foreground">
            Formación continua
          </p>
          <p class="text-base font-medium text-foreground">{profile.continuingEducation.title}</p>
          <p class="font-mono text-caption text-positive">{profile.continuingEducation.status}</p>
        </Surface>
      </div>
    </div>
  </Container>

  <section id="especialidades" class="border-y border-border bg-surface/40">
    <Container class="py-16 sm:py-20 lg:py-24">
      <div class="flex flex-col gap-10">
        <SectionHeading
          number="02"
          label="Especialidades"
          title="Cuatro áreas, una mirada de extremo a extremo"
          description="Trabajo en la intersección entre producto, arquitectura e implementación. La profundidad técnica se adapta a cada problema, no al revés."
        />

        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {
            specialties.map((specialty, index) => (
              <Surface
                as="article"
                variant="default"
                padding="md"
                class="portfolio-card-hover flex h-full flex-col gap-4"
              >
                <span class="font-mono text-label text-primary">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="text-title font-semibold text-foreground">{specialty.title}</h3>
                <p class="text-sm text-muted-foreground">{specialty.description}</p>
                <p class="mt-auto border-t border-border pt-4 font-mono text-caption text-muted-foreground">
                  {specialty.technologies}
                </p>
              </Surface>
            ))
          }
        </div>

        <Surface variant="raised" class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-col gap-1">
            <p class="font-mono text-label uppercase tracking-widest text-primary">Full Stack</p>
            <p class="text-base font-medium text-foreground">Del análisis al despliegue</p>
          </div>
          <p class="max-w-measure text-sm text-muted-foreground">
            También cubro la infraestructura y la puesta en marcha: servidores Linux/Ubuntu, proxy
            inverso con Nginx y contenedores Docker.
          </p>
        </Surface>

        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="hidden h-px w-8 shrink-0 bg-border sm:block"></span>
          <p class="shrink-0 font-mono text-[0.6875rem] tracking-wide text-muted-foreground sm:text-label">
            Tecnologías con las que he trabajado
          </p>
          <span aria-hidden="true" class="h-px min-w-0 flex-1 bg-border"></span>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            technologyGroups.map((group) => (
              <div class="flex flex-col gap-3">
                <h3 class="font-mono text-label uppercase tracking-widest text-muted-foreground">
                  {group.title}
                </h3>
                <ul class="flex flex-wrap gap-2" aria-label={group.title}>
                  {group.items.map((item) => (
                    <li>
                      <TechBadge label={item} />
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <Container as="section" id="proyectos" class="py-16 sm:py-20 lg:py-24">
    <div class="flex flex-col gap-10">
      <SectionHeading
        number="03"
        label="Proyectos"
        title="Productos construidos sobre problemas concretos"
      />

      <div class="grid gap-6 md:grid-cols-2">
        {
          projectCards.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.summary}
              category={project.category}
              status={project.status}
              technologies={project.technologies}
              href={project.href}
              image={project.image}
            />
          ))
        }
      </div>
    </div>
  </Container>

  <section id="proceso" class="border-y border-border bg-surface/40">
    <Container class="py-16 sm:py-20 lg:py-24">
      <div class="flex flex-col gap-10">
        <SectionHeading
          number="04"
          label="Cómo trabajo"
          title="Un proceso, no una plantilla"
          description="Un enfoque personal para reducir incertidumbre y mantener el software comprensible a medida que crece."
        />

        <ol class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {
            processSteps.map((step, index) => (
              <Surface
                as="li"
                variant="default"
                padding="md"
                class="portfolio-card-hover flex h-full flex-col gap-4"
              >
                <div class="flex items-center justify-between gap-3">
                  <span class="font-mono text-label text-primary">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span aria-hidden="true" class="h-px flex-1 bg-border"></span>
                </div>
                <h3 class="text-title font-semibold text-foreground">{step.title}</h3>
                <p class="text-sm text-muted-foreground">{step.description}</p>
              </Surface>
            ))
          }
        </ol>
      </div>
    </Container>
  </section>

  <Container class="py-14 sm:py-16">
    <section
      aria-labelledby="onondive-titulo"
      class="flex flex-col gap-3 border-l-2 border-primary/40 pl-5 sm:pl-6"
    >
      <p class="font-mono text-label uppercase tracking-widest text-muted-foreground">
        Iniciativa
      </p>
      <h2 id="onondive-titulo" class="text-title font-semibold text-foreground">
        {profile.initiative.name} — {profile.initiative.note}
      </h2>
      <p class="max-w-measure text-sm text-muted-foreground">
        Estoy dando forma a Oñondive, una iniciativa con la que quiero desarrollar soluciones
        tecnológicas para necesidades reales del mercado paraguayo.
      </p>
      <p class="max-w-measure text-sm text-muted-foreground">
        Mi objetivo es construir software útil, pensado para evolucionar y crecer con quienes lo
        utilizan.
      </p>
    </section>
  </Container>

  <section id="contacto" class="border-t border-border bg-surface">
    <Container class="py-16 sm:py-20 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-16">
        <div class="flex flex-col gap-6">
          <SectionHeading
            number="05"
            label="Contacto"
            title="Contacto profesional"
            description={profile.availability}
          />
          <p class="max-w-measure text-sm text-muted-foreground">
            Para conversar sobre un proyecto, una colaboración o una oportunidad profesional, el
            correo es el canal más directo. También puedes encontrarme en las redes profesionales.
          </p>
          <div class="flex flex-wrap gap-3">
            <ButtonLink href={emailHref} variant="primary" size="lg">
              Escribir por correo
            </ButtonLink>
            <ButtonLink href={profile.github} variant="secondary" size="lg" external>
              Ver GitHub <span aria-hidden="true">↗</span>
            </ButtonLink>
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <Surface variant="raised" class="flex flex-col gap-2">
            <p class="font-mono text-label uppercase tracking-widest text-muted-foreground">
              Correo profesional
            </p>
            <a
              href={emailHref}
              class="break-all rounded-sm text-base font-medium text-foreground underline-offset-4 hover:underline"
            >
              {profile.email}
            </a>
          </Surface>

          <nav aria-label="Redes profesionales">
            <ul class="flex flex-col divide-y divide-border border-y border-border">
              {
                contactChannels.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="flex items-center justify-between gap-4 py-3 text-sm text-muted-foreground transition-colors hover:text-foreground"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span>{link.label}</span>
                      <span aria-hidden="true" class="font-mono text-caption">↗</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
