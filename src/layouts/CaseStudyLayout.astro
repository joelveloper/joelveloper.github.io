---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import ProjectIllustration from '@/components/ui/ProjectIllustration.astro';
import StatusBadge from '@/components/ui/StatusBadge.astro';
import TechBadge from '@/components/ui/TechBadge.astro';
import { detailNavigation } from '@/data/navigation';
import { profile } from '@/data/profile';
import type { ProjectEntry } from '@/lib/projects';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;

const categoryLabels = {
  saas: 'SaaS',
  client: 'Desarrollo exclusivo',
} as const;

const image = data.image?.usageApproved === true ? data.image : undefined;
---

<BaseLayout
  title={`${data.title} · ${profile.name}`}
  description={data.summary}
  nav={detailNavigation}
  type="article"
>
  <article>
    <header class="border-b border-border bg-surface/40">
      <Container class="py-10 sm:py-14 lg:py-20">
        <nav aria-label="Ruta de navegación" class="text-caption text-muted-foreground">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a
                href="/#proyectos"
                class="inline-flex min-h-6 items-center rounded-sm underline-offset-4 hover:text-foreground hover:underline"
              >
                Proyectos
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-foreground">{data.cardTitle}</li>
          </ol>
        </nav>

        <div
          class:list={[
            'mt-8 grid gap-10',
            image && 'lg:grid-cols-[minmax(0,1fr)_minmax(0,0.55fr)] lg:items-start',
          ]}
        >
          <div class="flex flex-col gap-5">
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-mono text-label uppercase tracking-widest text-primary">
                {categoryLabels[data.category]}
              </span>
              <StatusBadge status={data.status} />
            </div>

            <h1
              id="caso-titulo"
              class="max-w-[24ch] text-balance text-[clamp(2rem,4.5vw,3.6rem)] font-semibold leading-[1.08] tracking-[-0.03em] text-foreground"
            >
              {data.cardTitle}
            </h1>

            <p class="max-w-measure text-lead text-muted-foreground">{data.summary}</p>
          </div>

          {
            image && (
              <ProjectIllustration
                image={image}
                loading="eager"
                width={320}
                height={180}
                class="aspect-[16/9] w-full rounded-xl border border-border object-cover"
              />
            )
          }
        </div>

        {
          data.technologies.length > 0 && (
            <div class="mt-8 flex flex-col gap-3 border-t border-border pt-6">
              <p class="font-mono text-label uppercase tracking-widest text-muted-foreground">
                Stack tecnológico
              </p>
              <ul class="flex flex-wrap gap-2" aria-label="Tecnologías del proyecto">
                {data.technologies.map((technology) => (
                  <li>
                    <TechBadge label={technology} />
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </Container>
    </header>

    <Container class="py-12 sm:py-16">
      <div class="mx-auto flex max-w-[72ch] flex-col">
        {
          data.facts && data.facts.length > 0 && (
            <section aria-label="Indicadores del proyecto" class="mb-12 border-y border-border py-6">
              <dl class="grid grid-cols-2 gap-6 sm:flex sm:flex-wrap sm:gap-x-12 sm:gap-y-6">
                {data.facts.map((fact) => (
                  <div class="flex flex-col-reverse gap-1">
                    <dt class="text-sm text-muted-foreground">{fact.label}</dt>
                    <dd class="font-mono text-2xl font-semibold text-foreground">
                      +{fact.value}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        <div class="case-study-prose">
          <slot />
        </div>

        <div class="mt-12 border-t border-border pt-6">
          <ButtonLink href="/#proyectos" variant="secondary">Volver a proyectos</ButtonLink>
        </div>
      </div>
    </Container>
  </article>
</BaseLayout>
