---
import '@/styles/global.css';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import type { NavItem } from '@/components/layout/SiteHeader.astro';

export interface Props {
  title: string;
  description?: string;
  nav?: NavItem[];
  brandHref?: string;
}

const { title, description, nav = [], brandHref = '/' } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
    >
      Saltar al contenido
    </a>

    <SiteHeader nav={nav} brandHref={brandHref} />

    <main id="contenido" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
